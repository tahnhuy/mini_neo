# Sao chép thành .env rồi đổi mọi giá trị "doi-mat-khau-*". Không commit .env.

# PostgreSQL: superuser của image, chỉ dùng cho script khởi tạo vai trò.
POSTGRES_PASSWORD=doi-mat-khau-postgres

# Mật khẩu ba vai trò của bài (docs/specs/data-model.md, mục 6).
MINI_OWNER_PASSWORD=doi-mat-khau-owner
MINI_APP_PASSWORD=doi-mat-khau-app
MINI_RELAY_PASSWORD=doi-mat-khau-relay

# Migration chạy bằng chủ bảng mini_owner.
MIGRATE_DATABASE_URL=postgres://mini_owner:doi-mat-khau-owner@127.0.0.1:5432/mini?sslmode=disable

# Service stock: kết nối bằng vai trò thường mini_app.
STOCK_DATABASE_URL=postgres://mini_app:doi-mat-khau-app@127.0.0.1:5432/mini?sslmode=disable
STOCK_GRPC_ADDR=127.0.0.1:50052

# Test tích hợp: tạo CSDL riêng bằng mini_owner, chạy test bằng mini_app.
TEST_OWNER_DATABASE_URL=postgres://mini_owner:doi-mat-khau-owner@127.0.0.1:5432/mini?sslmode=disable
TEST_APP_DATABASE_URL=postgres://mini_app:doi-mat-khau-app@127.0.0.1:5432/mini?sslmode=disable
